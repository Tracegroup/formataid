# Copy to .env.local for local dev; set the same keys in Vercel → Project → Settings → Environment Variables.

# --- Database (own database, separate from meetagent) ---
MONGODB_URI=
MONGODB_DB=formatassist

# --- Claude ---
CLAUDE_API_KEY=

# --- File storage (S3, shared bucket with proposalagent; keys are prefixed formatassist/) ---
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# --- Auth ---
# Random 32+ byte secret used to sign session cookies.
AUTH_SECRET=
# Used only by `npm run seed` to create the first super admin (must change password at first login).
SUPERADMIN_EMAIL=
SUPERADMIN_NAME=Super Admin
SUPERADMIN_PASSWORD=
